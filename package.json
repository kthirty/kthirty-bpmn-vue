{
  "name": "kthirty-bpmn-vue3",
  "version": "0.0.8",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "main": "./dist/kthirty-bpmn-vue.umd.cjs",
  "module": "./dist/kthirty-bpmn-vue.js",
  "types": "./dist/types/index.d.ts",
  "browser": "./dist/kthirty-bpmn-vue.js",
  "unpkg": "dist/kthirty-bpmn-vue.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kthirty-bpmn-vue.js",
      "require": "./dist/kthirty-bpmn-vue.umd.cjs"
    },
    "./css": "./dist/style.css",
    "./BpmnDesigner": {
      "types": "./dist/types/BpmnDesigner/index.d.ts",
      "import": "./dist/entries/BpmnDesigner.js",
      "require": "./dist/entries/BpmnDesigner.cjs"
    },
    "./Designer": {
      "types": "./dist/types/Designer/index.d.ts",
      "import": "./dist/entries/Designer.js",
      "require": "./dist/entries/Designer.cjs"
    },
    "./Panel": {
      "types": "./dist/types/Panel/index.d.ts",
      "import": "./dist/entries/Panel.js",
      "require": "./dist/entries/Panel.cjs"
    },
    "./Toolbar": {
      "types": "./dist/types/Toolbar/index.d.ts",
      "import": "./dist/entries/Toolbar.js",
      "require": "./dist/entries/Toolbar.cjs"
    },
    "./SelectableDrawer": {
      "types": "./dist/types/SelectableDrawer/index.d.ts",
      "import": "./dist/entries/SelectableDrawer.js",
      "require": "./dist/entries/SelectableDrawer.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --port 8000 --open",
    "docs:build": "vitepress build docs",
    "docs:deploy": "sh scripts/deploy.sh",
    "build:example": "vite build --mode example",
    "publish:page": "sh scripts/page.sh",
    "dev": "vite",
    "pub": "node scripts/release.mjs",
    "release": "node scripts/release.mjs",
    "push": "sh scripts/push.sh",
    "build": "run-s format clean build:lib build:entries",
    "build:entries": "node scripts/entries.mjs",
    "prepublishOnly": "pnpm build",
    "format": "prettier --write src/ packages/",
    "clean": "rimraf ./dist",
    "build:lib": "run-p type-check build:types build:es build:browser",
    "type-check": "vue-tsc --noEmit",
    "build:es": "vite build",
    "build:browser": "vite -f iife build",
    "preview": "vite preview --outDir dist --base /kthirty-bpmn-vue/",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types --project tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "bpmn-js": "^17.9.2",
    "bpmn-js-bpmnlint": "^0.22.3",
    "bpmn-js-color-picker": "^0.7.1",
    "bpmn-js-create-append-anything": "^0.5.2",
    "bpmn-moddle": "8.1.0",
    "bpmnlint": "^10.3.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/node": "^22.1.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/tsconfig": "^0.5.1",
    "ant-design-vue": "^4.2.3",
    "eslint": "^9.8.0",
    "eslint-plugin-vue": "^9.27.0",
    "less": "^4.2.0",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.5.4",
    "unplugin-vue-components": "^0.27.3",
    "vite": "^5.3.5",
    "vitepress": "^1.3.2",
    "vue": "^3.4.36",
    "vue-router": "^4.4.3",
    "vue-tsc": "^2.0.29"
  },
  "sideEffects": [
    "dist/*"
  ],
  "description": "Bpmn Vue Components Library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kthirty/kthirty-bpmn-vue.git"
  },
  "keywords": [
    "Vue3",
    "TS",
    "Vite",
    "Less",
    "KThirty",
    "Components",
    "Bpmn",
    "Flowable"
  ],
  "author": "kthirty",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kthirty/kthirty-bpmn-vue/issues"
  },
  "homepage": "https://kthirty.github.io/kthirty-bpmn-vue",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}

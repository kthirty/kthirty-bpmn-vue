{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "packages/**/*.vue", "packages/**/*.d.ts"],
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "rootDir": "packages",
    "jsx": "preserve",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "removeComments": false
  }
}
